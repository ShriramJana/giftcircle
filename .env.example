# GiftCircle environment
#
# Copy to .env.local and fill in the values from your Supabase project
# (Dashboard → Project Settings → API, or `supabase status` for local dev).
#
# If BOTH values are left unset, the app runs in credential-free demo mode:
# an in-memory store seeded with the sample wedding + baby shower fixtures.
# Data resets on server restart. Never use demo mode in production.

NEXT_PUBLIC_SUPABASE_URL=
# The publishable (sb_publishable_...) key — or a legacy anon key via
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Never put the service_role/secret key in any
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: default coordinates for biasing location-search results when the
# request has no IP geolocation (local development). Defaults to the
# continental US. On Vercel, each visitor's own IP location is used instead.
GEOCODE_BIAS_LAT=
GEOCODE_BIAS_LON=
